#!/bin/bash
# guard-device フックの判定が退行していないことをコミット前に確認する。
# 有効化(クローン直後に一度だけ): git config core.hooksPath .githooks

set -uo pipefail

repo_root=$(git rev-parse --show-toplevel)
test_script="$repo_root/.claude/hooks/guard-device.test.sh"

if [ ! -x "$test_script" ]; then
  echo "pre-commit: $test_script が無い(または実行できない)ためコミットを中止しました。" >&2
  echo "guard-device の防御を意図的に外す場合は、この pre-commit も一緒に外してください。" >&2
  exit 1
fi

if ! output=$("$test_script" 2>&1); then
  echo "$output" >&2
  echo "pre-commit: guard-device の回帰テストが失敗したためコミットを中止しました。" >&2
  exit 1
fi
